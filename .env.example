# =============================================================================
# MediBot Django Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values

# Django Core
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database (PostgreSQL with pgvector)
DB_DEV_NAME=medibot
DB_DEV_USER=postgres
DB_DEV_PASSWORD=postgres
DB_DEV_HOST=localhost
DB_DEV_PORT=5432

DB_NAME=medibot
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# JWT Authentication
ACCESS_TOKEN_LIFETIME=60
REFRESH_TOKEN_LIFETIME=7

# Celery & Redis
BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_CACHE_BACKEND=redis://localhost:6379/2
REDIS_HOST=localhost

# Google Gemini API Keys 
GOOGLE_API_KEY=your-google-api-key
GOOGLE_GEMINI_API_KEYS=key1,key2,key3
GOOGLE_GEMINI_PAID_API_KEYS=paid-key1,paid-key2

# OpenRouter API Key
OPENROUTER_API_KEY=key1

# Vector Store Paths
VECTOR_DB_PATH=./vector_db
VECTOR_DB_BACKUP_PATH=./vector_db_backup

# Data Processing
DATA_DIR=./processed_data

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
ALLOWED_HOSTS=medibot-api.yudhna.id.vn,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://medibot.yudhna.id.vn
CSRF_TRUSTED_ORIGINS=https://medibot.yudhna.id.vn
CORS_ALLOW_CREDENTIALS=True

AUTH_ACCESS_COOKIE_NAME=medibot_access
AUTH_REFRESH_COOKIE_NAME=medibot_refresh
AUTH_COOKIE_DOMAIN=.yudhna.id.vn
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=None
AUTH_ACCESS_COOKIE_PATH=/
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth/

TEI_ENDPOINT_URL=http://localhost:8080/v1/embeddings

ENABLE_SQL_DEBUG_LOGGING=False

# Admin bootstrap
RUN_SEED_ADMIN_USER=True
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@example.com
